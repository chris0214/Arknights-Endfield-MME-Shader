<Window x:Class="EndfieldShaderTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endfield Shader Tool" Height="920" Width="1440"
        MinHeight="760" MinWidth="1180"
        Background="#111315" Foreground="#F1F4F2"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#191C1E" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#202426" />
        <SolidColorBrush x:Key="BorderBrush" Color="#343A3C" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F4F2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9BA5A2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#35BFA0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#47D0AF" />
        <SolidColorBrush x:Key="AmberBrush" Color="#E3B563" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E47474" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121516" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#6751C9AC" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="#B9C1BF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="#121516" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="1" BorderBrush="#303638" BorderThickness="1,0,0,0" />
                    <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="#AAB4B1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#56605E" />
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#171B1C" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#1A1E20" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B3B37" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#275148" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#121516" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Template="{StaticResource ComboBoxToggleTemplate}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="SelectionContent" Margin="10,0,36,0" IsHitTestVisible="False"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Hidden"
                                     Margin="9,1,36,1" Padding="0" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Focusable="False">
                                <Border Background="#1A1E20" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,3,0,0" MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}">
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionContent" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="34" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#282D2F" />
            <Setter Property="BorderBrush" Value="#3B4244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343A3C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#56605E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#071713" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}" />

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#171A1C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowBackground" Value="#181B1D" />
            <Setter Property="AlternatingRowBackground" Value="#1D2022" />
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#24292B" />
            <Setter Property="Foreground" Value="#AEB7B4" />
            <Setter Property="BorderBrush" Value="#353B3D" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27302E" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#27463F" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="IconTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171A1C" BorderBrush="#2B3032" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Endfield Shader Generator" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="MME CHARACTER PACKAGE WORKSPACE" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Margin="16,14,16,10" Padding="15,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="ENDFIELD 模板" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TemplateText" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Content="&#xE8B7;" ToolTip="选择 ShaderTemplate 模板目录" Click="ChooseTemplate_Click" />
                    </Grid>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="PMX 模型" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PmxText" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Content="&#xE8E5;" ToolTip="选择 PMX 文件" Click="ChoosePmx_Click" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="角色名称" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="RoleText" Grid.Row="1" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputText" />
                            <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Content="&#xE8B7;" ToolTip="选择角色包输出目录" Click="ChooseOutput_Click" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="FXC 编译器（可选）" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FxcText" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Content="&#xE8E5;" ToolTip="选择 fxc.exe" Click="ChooseFxc_Click" />
                    </Grid>
                </Grid>

            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#171A1C" BorderBrush="#2C3233" BorderThickness="0,1,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Click="ImportPmx_Click" ToolTip="读取 PMX 材质">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="导入 PMX"/></StackPanel>
                    </Button>
                    <Button Click="OpenProject_Click" ToolTip="打开 Endfield 工程">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="打开工程"/></StackPanel>
                    </Button>
                    <Button Click="SaveProject_Click" ToolTip="保存当前工程">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="保存"/></StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="26" Background="#3A4042" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="AddPreset_Click" ToolTip="添加材质预设">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="添加"/></StackPanel>
                    </Button>
                    <Button Click="CopyPreset_Click" ToolTip="复制当前预设">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="复制"/></StackPanel>
                    </Button>
                    <Button Click="MergePresets_Click" ToolTip="将左侧多选的材质球合并，共用一套 FX 和参数">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B6;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="合并所选"/></StackPanel>
                    </Button>
                    <Button Click="UnmergePreset_Click" ToolTip="将当前合并材质球拆回多个独立材质球，并保留现有贴图与参数">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="解除合并"/></StackPanel>
                    </Button>
                    <Button Click="DeletePreset_Click" Foreground="#F0A0A0" ToolTip="删除当前预设">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="删除"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <CheckBox x:Name="GenerateEmmCheck" Content="生成 EMM" IsChecked="True" Margin="0,0,12,0"
                              ToolTip="生成带当前绝对路径的 MME 自动映射文件；移动目录后需要重新生成" />
                    <CheckBox x:Name="EyeThroughCheck" Content="眼透" IsChecked="True" Margin="0,0,10,0"
                              ToolTip="生成或复用同目录的眼透派生 PMX；只在 Iris 与 BrowLash 材质已明确时执行，绝不覆盖原模型" />
                    <CheckBox x:Name="PostProcessingCheck" Content="后处理" IsChecked="True" Margin="0,0,12,0"
                              ToolTip="包含全局 Bloom、Tonemap、曝光、白平衡和可选锐化" />
                    <Button Click="Compile_Click" ToolTip="静态验证并使用 FXC 编译">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="编译检查"/></StackPanel>
                    </Button>
                    <Button Click="OpenOutput_Click" ToolTip="打开最近生成的目录">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="输出目录"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click" ToolTip="生成独立角色 MME 包">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="生成角色包"/></StackPanel>
                    </Button>
                    <Button Click="ExportProfile_Click" ToolTip="只导出当前选中的材质预设">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconTextStyle}"/><TextBlock Text="导出当前"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540" MinWidth="400" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Shader 材质球" FontSize="15" FontWeight="SemiBold" />
                                <Border Background="#263D37" CornerRadius="4" Padding="7,2" Margin="9,0,0,0">
                                    <TextBlock x:Name="MaterialCountText" Text="0" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Ctrl / Shift 多选后合并" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="MaterialsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionChanged="MaterialsGrid_SelectionChanged" EnableRowVirtualization="True" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PMX #" Binding="{Binding MaterialIndexDisplay}" Width="82" IsReadOnly="True" />
                            <DataGridTextColumn Header="绑定材质" Binding="{Binding MaterialNameDisplay}" Width="125" IsReadOnly="True" />
                            <DataGridTextColumn Header="材质球" Binding="{Binding ProfileName}" Width="125" IsReadOnly="True" />
                            <DataGridTextColumn Header="数量" Binding="{Binding BindingCount}" Width="44" IsReadOnly="True" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Domain}" Width="96" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="影" Binding="{Binding CastExcellentShadow}" Width="38" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="材质球参数" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedMaterialText" Text="未选择材质" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2D3025" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="可拖入贴图或文件夹" Foreground="{StaticResource AmberBrush}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AllowDrop="True" Drop="Editor_Drop" Padding="15">
                        <StackPanel x:Name="EditorPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#0C0E0F" BorderBrush="#2C3133" BorderThickness="0,1,0,0">
            <Grid Margin="16,10,16,14">
                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="生成日志" FontWeight="SemiBold" />
                        <TextBlock Text="  /  路径、依赖和 FXC 结果" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="清空" Click="ClearLog_Click" Padding="10,4" Margin="0" />
                </Grid>
                <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="#0C0E0F" BorderThickness="0"
                         Foreground="#BCC6C3" Padding="0,6,0,0" FontFamily="Consolas" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>


